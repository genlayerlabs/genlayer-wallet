{
  "name": "@genlayer/transaction-kit",
  "version": "0.1.0",
  "description": "Framework-agnostic GenLayer transaction policy, submission, tracking, and verification helpers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --splitting false --clean",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "ethers": "^6.13.5",
    "genlayer-js": "github:genlayerlabs/genlayer-js#v2-dev"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
